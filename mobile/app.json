{
  "expo": {
    "name": "Cricket Sports Platform",
    "slug": "cricket-platform",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/startup/login_welcome.jpeg",
      "resizeMode": "cover",
      "backgroundColor": "#1a1a2e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cricketplatform.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.cricketplatform.app",
      "versionCode": 1
    },
    "web": {},
    "plugins": [
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "178a79a6-8df9-4d4c-a4cc-4f4db4343e26"
      }
    }
  }
}
